--- /dev/null
+++ b/include/strata/core/split_schedule.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include <cstddef>
+#include <vector>
+
+namespace strata::core {
+// Automatic placement still uses distinct GPUs. An explicit schedule may
+// return to CUDA0 for its final stage, with independent stage state/cache.
+inline bool split_devices_valid(const std::vector<int>& devices, int count,
+                                bool automatic, bool same_device) {
+    if (same_device) return !automatic && devices.size() == 1 && devices[0] == 0;
+    for (std::size_t i = 0; i < devices.size(); ++i) {
+        const int dev = devices[i];
+        if (dev < 0 || dev >= count) return false;
+        if (dev == 0 && (automatic || devices.size() < 2 || i + 1 != devices.size())) return false;
+        for (std::size_t j = 0; j < i; ++j) if (dev == devices[j]) return false;
+    }
+    return true;
+}

--- /dev/null
+++ after/include/strata/core/split_schedule.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include <cstddef>
+#include <vector>
+
+namespace strata::core {
+// Automatic placement still uses distinct GPUs. An explicit schedule may
+// return to CUDA0 for its final stage, with independent stage state/cache.
+inline bool split_devices_valid(const std::vector<int>& devices, int count,
+                                bool automatic, bool same_device) {
+    if (same_device) return !automatic && devices.size() == 1 && devices[0] == 0;
+    for (std::size_t i = 0; i < devices.size(); ++i) {
+        const int dev = devices[i];
+        if (dev < 0 || dev >= count) return false;
+        if (dev == 0 && (automatic || devices.size() < 2 || i + 1 != devices.size())) return false;
+        for (std::size_t j = 0; j < i; ++j) if (dev == devices[j]) return false;
+    }
+    return true;
+}
+} // namespace strata::core
--- /dev/null
+++ after/src/core/split_schedule_test.cpp
@@ -0,0 +1,21 @@
+#include "strata/core/split_schedule.hpp"
+#include <cstdio>
+
+int main() {
+    using strata::core::split_devices_valid;
+    struct Case { std::vector<int> devices; int count; bool automatic, same, valid; };
+    const Case cases[] = {
+        {{1}, 2, false, false, true}, {{1, 2}, 3, true, false, true},
+        {{1, 0}, 2, false, false, true}, {{2, 1, 0}, 3, false, false, true},
+        {{0}, 1, false, true, true}, {{1, 0}, 2, true, false, false},
+        {{0, 1}, 2, false, false, false}, {{1, 0, 2}, 3, false, false, false},
+        {{1, 1}, 2, false, false, false}, {{1, 2}, 2, false, false, false},
+        {{-1}, 2, false, false, false}, {{0}, 1, true, true, false},
+        {{1}, 2, false, true, false}, {{0}, 2, false, false, false}
+    };
+    for (const auto& c : cases)
+        if (split_devices_valid(c.devices, c.count, c.automatic, c.same) != c.valid) {
+            std::fprintf(stderr, "split schedule validation failed\n"); return 1;
+        }
+    std::puts("split schedule validation: 14 cases passed");
+}
